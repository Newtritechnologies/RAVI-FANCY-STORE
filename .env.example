# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MONGODB_URI: Optional MongoDB connection string for persistent store catalog & orders.
# When omitted, the server persists data locally in data/ravi-fancy-store.json.
MONGODB_URI=""

# ADMIN_PASSWORD: Password for the RAVI FANCY STORE Admin Dashboard.
ADMIN_PASSWORD="MY_ADMIN_PASSWORD"

# SESSION_SECRET: Secret key used to sign admin session tokens.
SESSION_SECRET="MY_SESSION_SECRET"

# RAZORPAY_KEY_ID & RAZORPAY_KEY_SECRET: Optional Razorpay Test Mode API credentials.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
